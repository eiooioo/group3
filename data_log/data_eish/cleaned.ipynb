   "source": [
    "## combining all the data\n",
    "import os\n",
    "import glob\n",
    "import pandas as pd\n",
    "\n",
    "# 1. Get all CSV files in the current folder (data_eish)\n",
    "csv_files = glob.glob(\"*.csv\")\n",
    "\n",
    "dfs = []\n",
    "\n",
    "for file in csv_files:\n",
    "    # Skip empty files or a previously generated master file\n",
    "    if os.path.getsize(file) == 0 or file == 'eish_combined_dataset.csv':\n",
    "        continue\n",
    "        \n",
    "    try:\n",
    "        temp_df = pd.read_csv(file)\n",
    "        if temp_df.empty:\n",
    "            continue\n",
    "            \n",
    "        # Clean column headers (remove leading/trailing spaces)\n",
    "        temp_df.columns = temp_df.columns.str.strip()\n",
    "        \n",
    "        # Track the source file name\n",
    "        temp_df['source_file'] = file\n",
    "        \n",
    "        dfs.append(temp_df)\n",
    "        print(f\"✅ Loaded: {file} ({len(temp_df)} rows)\")\n",
    "    except Exception as e:\n",
    "        print(f\"❌ Error loading {file}: {e}\")\n",
    "\n",
    "# 2. Combine all dataframes from data_eish\n",
    "if dfs:\n",
    "    eish_master_df = pd.concat(dfs, ignore_index=True)\n",
    "    \n",
    "    # Save the merged file directly in data_eish\n",
    "    output_filename = 'eish_combined_dataset.csv'\n",
    "    eish_master_df.to_csv(output_filename, index=False)\n",
    "    \n",
    "    print(\"\\n\" + \"=\"*45)\n",
    "    print(f\"🎉 Combined {len(dfs)} files from data_eish successfully!\")\n",
    "    print(f\"📊 Total Rows: {len(eish_master_df)}\")\n",
    "    print(f\"💾 Saved output to: {os.path.abspath(output_filename)}\")\n",
    "    print(\"=\"*45)\n",
    "    \n",
    "    display(eish_master_df.head())\n",
    "else:\n",
    "    print(\"❌ No CSV files found in data_eish.\")"
   ]
  }
